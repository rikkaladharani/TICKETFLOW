          "name": "Get Event Rating Summary",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/reviews/event/{{event_id}}/rating", "host": ["{{base_url}}"], "path": ["reviews", "event", "{{event_id}}", "rating"] }
          }
        }
      ]
    },
    {
